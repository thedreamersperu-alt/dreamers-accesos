# Token del bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# ID de tu servidor (clic derecho al servidor > Copiar ID, con Modo desarrollador activado)
GUILD_ID=

# Contraseña para entrar al panel web
ADMIN_PASSWORD=cambia-esto

# Puerto del panel
PORT=3000

# Días antes del vencimiento para avisar por DM al alumno (0 = no avisar)
REMINDER_DAYS=3

# Texto extra del aviso (ej. link de renovación)
RENEW_TEXT=Escríbenos para renovar tu acceso.

# Pon true si el panel se sirve por HTTPS (recomendado en producción)
COOKIE_SECURE=false

# Ruta del archivo de base de datos
DB_PATH=data.db
